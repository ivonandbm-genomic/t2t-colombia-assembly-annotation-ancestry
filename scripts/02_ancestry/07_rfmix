            odir / "0000.vcf.gz",
            odir / "0000.vcf.gz.tbi",
            odir / "0001.vcf.gz",
            odir / "0001.vcf.gz.tbi",
            odir / "README.txt",
            odir / "sites.txt",
        ]

        for p in to_remove:
            if p.exists():
                if p.is_dir():
                    shutil.rmtree(p)
