BASE_DIR = "/home/rare/ivon/data/vcf_filtrados/newfil/bialelicos/18genomes/plink_individual"
OUT_DIR  = "/home/rare/ivon/figpaper"
PREFIX   = "merged_18_1200_common_qc05_maf05_nomind_pruned"
